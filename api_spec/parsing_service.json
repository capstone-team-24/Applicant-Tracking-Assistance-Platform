{
    "openapi": "3.1.0",
    "info": {
        "title": "ATS Parsing Service",
        "description": "Microservice that parses resumes, extracts structured text, computes vector embeddings, and stores them in Weaviate.",
        "version": "1.0.0"
    },
    "paths": {
        "/parse": {
            "post": {
                "tags": [
                    "parsing"
                ],
                "summary": "Submit Parse",
                "description": "Accept a resume parse request and execute the pipeline synchronously.\n\nIn production this could be made asynchronous by publishing to Kafka\nand returning immediately.  For simplicity the default behaviour is\nsynchronous.",
                "operationId": "submit_parse_parse_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ParseRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ParseResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/parse/{application_id}/status": {
            "get": {
                "tags": [
                    "parsing"
                ],
                "summary": "Get Parse Status",
                "description": "Return the current status of a parse job for the given application.",
                "operationId": "get_parse_status_parse__application_id__status_get",
                "parameters": [
                    {
                        "name": "application_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Application Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ParseStatusResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "tags": [
                    "health"
                ],
                "summary": "Health Check",
                "description": "Simple liveness probe.",
                "operationId": "health_check_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "ParseRequest": {
                "properties": {
                    "applicationId": {
                        "type": "string",
                        "title": "Applicationid",
                        "description": "UUID of the application"
                    },
                    "filePath": {
                        "type": "string",
                        "title": "Filepath",
                        "description": "Path to the resume file on disk or in storage"
                    }
                },
                "type": "object",
                "required": [
                    "applicationId",
                    "filePath"
                ],
                "title": "ParseRequest",
                "description": "Incoming request to parse a resume."
            },
            "ParseResponse": {
                "properties": {
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "description": "Current status of the parse job"
                    },
                    "parsedJsonUrl": {
                        "type": "string",
                        "title": "Parsedjsonurl",
                        "description": "URL to poll for parsed result / status"
                    },
                    "parseConfidence": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Parseconfidence",
                        "description": "Overall confidence score (0-1) if already available"
                    }
                },
                "type": "object",
                "required": [
                    "status",
                    "parsedJsonUrl"
                ],
                "title": "ParseResponse",
                "description": "Response returned immediately after a parse request is accepted."
            },
            "ParseStatusResponse": {
                "properties": {
                    "applicationId": {
                        "type": "string",
                        "title": "Applicationid"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status"
                    },
                    "parseConfidence": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Parseconfidence"
                    },
                    "chunkCount": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Chunkcount"
                    }
                },
                "type": "object",
                "required": [
                    "applicationId",
                    "status"
                ],
                "title": "ParseStatusResponse",
                "description": "Detailed status of a parse job."
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}