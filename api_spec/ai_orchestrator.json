{
    "openapi": "3.1.0",
    "info": {
        "title": "ATS AI Orchestrator",
        "description": "RAG-based candidate ranking service. Uses Weaviate vector search and configurable LLM adapters to produce composite scores and explainable summaries for each candidate.",
        "version": "1.0.0"
    },
    "paths": {
        "/rank": {
            "post": {
                "tags": [
                    "ranking"
                ],
                "summary": "Trigger Ranking",
                "description": "Manually trigger a candidate ranking job.\n\nCreates a ``RankingJob``, kicks off the pipeline in a background thread,\nand immediately returns the job ID so the caller can poll for results.",
                "operationId": "trigger_ranking_rank_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RankRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/rank/{ranking_job_id}": {
            "get": {
                "tags": [
                    "ranking"
                ],
                "summary": "Get Ranking Status",
                "description": "Return the current status (and results, if completed) of a ranking job.",
                "operationId": "get_ranking_status_rank__ranking_job_id__get",
                "parameters": [
                    {
                        "name": "ranking_job_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Ranking Job Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RankStatusResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/audit/export": {
            "get": {
                "tags": [
                    "audit"
                ],
                "summary": "Export Audit Logs",
                "description": "Export LLM audit logs for compliance review.",
                "operationId": "export_audit_logs_audit_export_get",
                "parameters": [
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 5000,
                            "minimum": 1,
                            "default": 100,
                            "title": "Limit"
                        }
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 0,
                            "default": 0,
                            "title": "Offset"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuditExportResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "tags": [
                    "health"
                ],
                "summary": "Health Check",
                "description": "Simple liveness probe.",
                "operationId": "health_check_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AuditExportResponse": {
                "properties": {
                    "records": {
                        "items": {
                            "$ref": "#/components/schemas/AuditRecord"
                        },
                        "type": "array",
                        "title": "Records"
                    },
                    "total": {
                        "type": "integer",
                        "title": "Total"
                    }
                },
                "type": "object",
                "required": [
                    "records",
                    "total"
                ],
                "title": "AuditExportResponse",
                "description": "Export wrapper for compliance audit."
            },
            "AuditRecord": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "rankingJobId": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Rankingjobid"
                    },
                    "candidateId": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Candidateid"
                    },
                    "modelName": {
                        "type": "string",
                        "title": "Modelname"
                    },
                    "promptHash": {
                        "type": "string",
                        "title": "Prompthash"
                    },
                    "promptTemplateId": {
                        "type": "string",
                        "title": "Prompttemplateid"
                    },
                    "inputVariables": {
                        "anyOf": [
                            {
                                "type": "object"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Inputvariables"
                    },
                    "rawResponse": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Rawresponse"
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Createdat"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "modelName",
                    "promptHash",
                    "promptTemplateId",
                    "createdAt"
                ],
                "title": "AuditRecord",
                "description": "Single LLM audit record."
            },
            "CandidateRankResult": {
                "properties": {
                    "candidateId": {
                        "type": "string",
                        "title": "Candidateid"
                    },
                    "applicationId": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Applicationid"
                    },
                    "semanticScore": {
                        "type": "number",
                        "title": "Semanticscore",
                        "default": 0
                    },
                    "assessmentScore": {
                        "type": "number",
                        "title": "Assessmentscore",
                        "default": 0
                    },
                    "llmQualityScore": {
                        "type": "number",
                        "title": "Llmqualityscore",
                        "default": 0
                    },
                    "compositeScore": {
                        "type": "number",
                        "title": "Compositescore",
                        "default": 0
                    },
                    "summary": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Summary"
                    },
                    "evidenceChunks": {
                        "anyOf": [
                            {
                                "items": {
                                    "type": "object"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Evidencechunks"
                    }
                },
                "type": "object",
                "required": [
                    "candidateId"
                ],
                "title": "CandidateRankResult",
                "description": "Single candidate outcome within a ranking job."
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "RankRequest": {
                "properties": {
                    "jobId": {
                        "type": "string",
                        "title": "Jobid"
                    },
                    "applicationIds": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Applicationids"
                    }
                },
                "type": "object",
                "required": [
                    "jobId",
                    "applicationIds"
                ],
                "title": "RankRequest",
                "description": "Payload to trigger a new ranking job."
            },
            "RankStatusResponse": {
                "properties": {
                    "rankingJobId": {
                        "type": "string",
                        "title": "Rankingjobid"
                    },
                    "jobId": {
                        "type": "string",
                        "title": "Jobid"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status"
                    },
                    "results": {
                        "anyOf": [
                            {
                                "items": {
                                    "$ref": "#/components/schemas/CandidateRankResult"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Results"
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Createdat"
                    },
                    "completedAt": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Completedat"
                    }
                },
                "type": "object",
                "required": [
                    "rankingJobId",
                    "jobId",
                    "status",
                    "createdAt"
                ],
                "title": "RankStatusResponse",
                "description": "Full status / result of a ranking job."
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}