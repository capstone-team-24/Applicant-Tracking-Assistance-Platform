                        "type": "string"
                    },
                    "yearsOfExperience": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "ProfileResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "authUserId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
