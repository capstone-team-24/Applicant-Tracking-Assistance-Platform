{
    "openapi": "3.1.0",
    "info": {
        "title": "ATS Assessment Service",
        "description": "Manages assessments (MCQ, short answer, code), proctoring events, and AI-powered scoring.",
        "version": "1.0.0"
    },
    "paths": {
        "/assessments": {
            "post": {
                "summary": "Create Assessment",
                "description": "Create a new assessment and generate a unique access token.",
                "operationId": "create_assessment_assessments_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateAssessmentRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AssessmentResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/assessments/by-job/{job_id}": {
            "get": {
                "summary": "Get Assessments By Job",
                "description": "Get all assessments linked to a specific job (recruiter view).",
                "operationId": "get_assessments_by_job_assessments_by_job__job_id__get",
                "parameters": [
                    {
                        "name": "job_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Job Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/AssessmentResponse"
                                    },
                                    "title": "Response Get Assessments By Job Assessments By Job  Job Id  Get"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/assessments/{token}": {
            "get": {
                "summary": "Get Assessment By Token",
                "description": "Fetch an assessment by its access token.\n\nIf candidateId is provided, an IN_PROGRESS submission is created\nautomatically (if one doesn't already exist for that candidate).",
                "operationId": "get_assessment_by_token_assessments__token__get",
                "parameters": [
                    {
                        "name": "token",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Token"
                        }
                    },
                    {
                        "name": "candidateId",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "title": "Candidateid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AssessmentResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/assessments/{assessment_id}/save": {
            "post": {
                "summary": "Autosave Answers",
                "description": "Autosave candidate answers (updates the submission JSON).",
                "operationId": "autosave_answers_assessments__assessment_id__save_post",
                "parameters": [
                    {
                        "name": "assessment_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Assessment Id"
                        }
                    },
                    {
                        "name": "candidateId",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Candidateid"
