                                "schema": {
                                    "$ref": "#/components/schemas/SubmissionResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/proctor/events": {
            "post": {
                "summary": "Create Proctoring Event",
                "description": "Record a proctoring event for a submission.",
                "operationId": "create_proctoring_event_proctor_events_post",
