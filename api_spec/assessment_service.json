    "components": {
        "schemas": {
            "AnswerSubmission": {
                "properties": {
                    "questionId": {
                        "type": "string",
                        "title": "Questionid"
                    },
                    "answer": {
                        "type": "string",
                        "title": "Answer"
                    }
                },
                "type": "object",
                "required": [
                    "questionId",
                    "answer"
                ],
                "title": "AnswerSubmission"
            },
            "AssessmentResponse": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "jobId": {
                        "type": "string",
                        "title": "Jobid"
                    },
                    "title": {
                        "type": "string",
                        "title": "Title"
                    },
                    "description": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Description"
                    },
                    "timeLimitMinutes": {
                        "type": "integer",
                        "title": "Timelimitminutes"
                    },
                    "questions": {
                        "items": {
                            "$ref": "#/components/schemas/Question"
                        },
                        "type": "array",
                        "title": "Questions"
                    },
                    "createdBy": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Createdby"
                    },
                    "accessToken": {
                        "type": "string",
                        "title": "Accesstoken"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status"
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Createdat"
                    },
                    "updatedAt": {
                        "type": "string",
                        "title": "Updatedat"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "jobId",
                    "title",
                    "timeLimitMinutes",
                    "questions",
                    "accessToken",
                    "status",
                    "createdAt",
                    "updatedAt"
                ],
                "title": "AssessmentResponse"
            },
            "AutosaveRequest": {
                "properties": {
                    "answers": {
                        "items": {
                            "$ref": "#/components/schemas/AnswerSubmission"
                        },
                        "type": "array",
                        "title": "Answers"
                    }
                },
                "type": "object",
                "required": [
                    "answers"
                ],
                "title": "AutosaveRequest"
            },
            "CreateAssessmentRequest": {
                "properties": {
                    "jobId": {
                        "type": "string",
                        "title": "Jobid"
                    },
                    "title": {
                        "type": "string",
                        "title": "Title"
                    },
                    "description": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Description"
                    },
                    "timeLimitMinutes": {
                        "type": "integer",
                        "title": "Timelimitminutes",
                        "default": 60
                    },
                    "questions": {
                        "items": {
                            "$ref": "#/components/schemas/Question"
                        },
                        "type": "array",
                        "title": "Questions"
                    }
                },
                "type": "object",
                "required": [
                    "jobId",
                    "title",
                    "questions"
                ],
                "title": "CreateAssessmentRequest"
            },
            "GenerateAssessmentRequest": {
                "properties": {
                    "jobId": {
                        "type": "string",
                        "title": "Jobid"
                    }
                },
                "type": "object",
                "required": [
                    "jobId"
                ],
                "title": "GenerateAssessmentRequest"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "ProctoringEventRequest": {
                "properties": {
                    "submissionId": {
                        "type": "string",
                        "title": "Submissionid"
                    },
                    "eventType": {
                        "type": "string",
                        "pattern": "^(TAB_CHANGE|MULTI_FACE|COPY_PASTE|WINDOW_BLUR)$",
                        "title": "Eventtype"
                    },
                    "eventData": {
                        "anyOf": [
                            {
                                "type": "object"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Eventdata"
                    },
                    "timestamp": {
                        "type": "string",
                        "title": "Timestamp"
                    }
                },
                "type": "object",
                "required": [
                    "submissionId",
                    "eventType",
                    "timestamp"
                ],
                "title": "ProctoringEventRequest"
            },
            "ProctoringEventResponse": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "submissionId": {
                        "type": "string",
                        "title": "Submissionid"
                    },
                    "eventType": {
                        "type": "string",
                        "title": "Eventtype"
                    },
                    "eventData": {
                        "anyOf": [
                            {
                                "type": "object"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Eventdata"
                    },
                    "timestamp": {
                        "type": "string",
                        "title": "Timestamp"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "submissionId",
                    "eventType",
                    "timestamp"
                ],
                "title": "ProctoringEventResponse"
            },
            "Question": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "type": {
                        "type": "string",
                        "pattern": "^(MCQ|SHORT_ANSWER|CODE)$",
                        "title": "Type"
                    },
                    "text": {
                        "type": "string",
                        "title": "Text"
                    },
                    "options": {
                        "anyOf": [
                            {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Options"
                    },
                    "correct_answer": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Correct Answer"
                    },
                    "max_score": {
                        "type": "number",
                        "title": "Max Score",
                        "default": 1
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "type",
                    "text"
                ],
                "title": "Question"
            },
            "ScoreDetail": {
                "properties": {
                    "questionId": {
                        "type": "string",
                        "title": "Questionid"
                    },
                    "questionType": {
                        "type": "string",
                        "title": "Questiontype"
                    },
                    "score": {
                        "type": "number",
                        "title": "Score"
                    },
                    "maxScore": {
                        "type": "number",
                        "title": "Maxscore"
                    },
                    "rationale": {
                        "type": "string",
                        "title": "Rationale"
                    }
                },
                "type": "object",
                "required": [
                    "questionId",
                    "questionType",
                    "score",
                    "maxScore",
                    "rationale"
                ],
                "title": "ScoreDetail"
            },
            "SubmissionResponse": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "assessmentId": {
                        "type": "string",
                        "title": "Assessmentid"
                    },
                    "candidateId": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Candidateid"
                    },
                    "score": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Score"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status"
                    },
                    "scoringDetails": {
                        "anyOf": [
                            {
                                "items": {
                                    "$ref": "#/components/schemas/ScoreDetail"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Scoringdetails"
                    },
                    "answers": {
                        "anyOf": [
                            {
                                "items": {
                                    "$ref": "#/components/schemas/AnswerSubmission"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Answers"
                    },
                    "startedAt": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Startedat"
                    },
                    "submittedAt": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Submittedat"
                    },
                    "scoredAt": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Scoredat"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "assessmentId",
                    "status"
                ],
                "title": "SubmissionResponse"
            },
            "SubmitRequest": {
                "properties": {
                    "answers": {
                        "items": {
                            "$ref": "#/components/schemas/AnswerSubmission"
                        },
                        "type": "array",
                        "title": "Answers"
                    }
                },
                "type": "object",
                "required": [
