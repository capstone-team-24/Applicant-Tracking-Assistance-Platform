                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/assessments/{assessment_id}/submit": {
            "post": {
                "summary": "Submit Assessment",
                "description": "Submit answers, trigger scoring, and return results.",
                "operationId": "submit_assessment_assessments__assessment_id__submit_post",
                "parameters": [
                    {
                        "name": "assessment_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Assessment Id"
                        }
                    },
                    {
                        "name": "candidateId",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Candidateid"
