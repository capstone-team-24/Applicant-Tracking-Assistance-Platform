                                        "$ref": "#/components/schemas/SubmissionResponse"
                                    },
                                    "title": "Response List Submissions Assessments  Assessment Id  Submissions Get"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/assessments/{assessment_id}/submissions/scored": {
            "get": {
                "summary": "List Scored Submissions",
                "description": "List all SCORED submissions for an assessment, sorted by score descending.",
                "operationId": "list_scored_submissions_assessments__assessment_id__submissions_scored_get",
                "parameters": [
                    {
                        "name": "assessment_id",
                        "in": "path",
