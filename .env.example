# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=ats_admin
POSTGRES_PASSWORD=ats_secret_2024
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
AUTH_DB=ats_auth
USER_DB=ats_users
JOBS_DB=ats_jobs
NOTIFICATION_DB=ats_notifications

# ── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ats
RABBITMQ_PASSWORD=ats_rabbit_2024

# ── Weaviate ──────────────────────────────────────────────
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080

# ── MinIO (optional) ─────────────────────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_2024
MINIO_ENDPOINT=http://minio:9000

# ── Eureka ────────────────────────────────────────────────
EUREKA_URI=http://eureka-server:8761/eureka

# ── Auth Service ──────────────────────────────────────────
AUTH_SERVICE_PORT=8081
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=ats-auth-service
JWT_AUDIENCE=ats-platform

# ── User Service ──────────────────────────────────────────
USER_SERVICE_PORT=8082

# ── Jobs Service ──────────────────────────────────────────
JOBS_SERVICE_PORT=8083

# ── Notification Service ──────────────────────────────────
NOTIFICATION_SERVICE_PORT=8084
SMTP_HOST=mailhog
SMTP_PORT=1025

# ── API Gateway ───────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_JWKS_URI=http://auth-service:8081/.well-known/jwks.json

# ── Parsing Service ──────────────────────────────────────
PARSING_SERVICE_PORT=8090
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEMO_MODE=true

# ── Assessment Service ────────────────────────────────────
ASSESSMENT_SERVICE_PORT=8091

# ── AI Orchestrator ──────────────────────────────────────
AI_ORCHESTRATOR_PORT=8092

# ── LLM Configuration (optional - leave blank for mock) ──
LLM_PROVIDER=groq
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=

# ── Google Calendar Integration ───────────────────────────
GOOGLE_CREDENTIALS_BASE64=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
