# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=ats_admin
POSTGRES_PASSWORD=ats_secret_2024
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
AUTH_DB=ats_auth
USER_DB=ats_users
JOBS_DB=ats_jobs
NOTIFICATION_DB=ats_notifications

# ── MinIO (optional) ─────────────────────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_2024
MINIO_ENDPOINT=http://minio:9000

# ── Eureka ────────────────────────────────────────────────
EUREKA_URI=http://eureka-server:8761/eureka

# ── Auth Service ──────────────────────────────────────────
AUTH_SERVICE_PORT=8081
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=ats-auth-service
JWT_AUDIENCE=ats-platform

# ── User Service ──────────────────────────────────────────
USER_SERVICE_PORT=8082

# ── Jobs Service ──────────────────────────────────────────
JOBS_SERVICE_PORT=8083

# ── Notification Service ──────────────────────────────────
NOTIFICATION_SERVICE_PORT=8084
SMTP_HOST=mailhog
SMTP_PORT=1025

# ── API Gateway ───────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_JWKS_URI=http://auth-service:8081/.well-known/jwks.json

# ── Hiring RAG Service ───────────────────────────────────
HIRING_RAG_SERVICE_PORT=8097
RAG_LLM_PROVIDER=groq
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CROSS_ENCODER_MODEL=kirubelmidru/resume-cross-encoder
CHROMA_COLLECTION_NAME=hiring_resumes

# ── Assessment Service ────────────────────────────────────
ASSESSMENT_SERVICE_PORT=8091

# ── LLM Configuration (optional - leave blank for mock) ──
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
